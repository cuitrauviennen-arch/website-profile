{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "Worked Projects Portfolio"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "category": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "link": {
      "type": "string"
    },
    "spanClass": {
      "type": "enumeration",
      "enum": [
        "span1",
        "span2",
        "span3"
      ],
      "default": "span1",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "metric": {
      "type": "string"
    },
    "metricLabel": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string"
    },
    "summary": {
      "type": "text"
    },
    "overview": {
      "type": "component",
      "repeatable": true,
      "component": "project.overview-item"
    },
    "metrics": {
      "type": "component",
      "repeatable": true,
      "component": "project.metric"
    },
    "phases": {
      "type": "component",
      "repeatable": true,
      "component": "project.phase"
    },
    "assets": {
      "type": "component",
      "repeatable": true,
      "component": "project.creative-asset"
    },
    "nextProject": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::project.project"
    }
  }
}
